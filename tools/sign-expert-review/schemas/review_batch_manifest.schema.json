{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handsignsfirststep.local/schemas/review-batch-manifest-v1.json",
  "title": "Restricted expert review batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "gloss_id",
    "revision",
    "created_at",
    "review_padding_sec",
    "manifest_sha256",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "sign-expert-review-batch-v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "batch_name": {"type": "string", "minLength": 1},
    "gloss_id": {"const": "좋다1"},
    "revision": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "review_padding_sec": {"const": 0.3},
    "batch_type": {"enum": ["PILOT", "FINAL"]},
    "corpus_complete": {"type": "boolean"},
    "missing_archives": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_archive_count": {"type": "integer", "minimum": 1},
    "expert_review_scope": {"type": "string", "minLength": 1},
    "recommended_max_candidates": {"type": "integer", "minimum": 60, "maximum": 120},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 150,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "signer_id",
        "session_id",
        "source_archive_id",
        "clip_filename",
        "clip_sha256",
        "clip_duration_sec",
        "fps_mode",
        "nominal_fps",
        "frame_count",
        "frame_pts_sec",
        "source_frame_pts_sec",
        "annotated_start_source_sec",
        "annotated_end_source_sec",
        "review_start_source_sec",
        "review_end_source_sec",
        "annotated_start_local_frame",
        "annotated_end_local_frame",
        "target_status"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "gloss_id": {"const": "좋다1"},
        "batch_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "signer_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "source_archive_id": {"type": "string", "minLength": 1},
        "source_member": {"type": "string"},
        "camera_view": {"type": "string"},
        "handedness": {"type": "string"},
        "mock_case": {"type": "string"},
        "precise_review_required": {"type": "boolean"},
        "precise_review_reason": {"type": "string"},
        "representative_final_candidate": {"type": "boolean"},
        "boundary_confidence": {"type": ["number", "string", "null"]},
        "auto_proposed_start_local_frame": {"type": ["integer", "null"], "minimum": 0},
        "auto_proposed_end_local_frame": {"type": ["integer", "null"], "minimum": 1},
        "auto_proposed_start_source_sec": {"type": ["number", "null"], "minimum": 0},
        "auto_proposed_end_source_sec": {"type": ["number", "null"], "minimum": 0},
        "drive_file_id": {"type": ["string", "null"]},
        "review_mode": {"enum": ["COARSE", "PRECISE"]},
        "selection_category": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "clip_filename": {"type": "string", "pattern": "\\.mp4$"},
        "clip_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "clip_size_bytes": {"type": "integer", "minimum": 1},
        "clip_duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "fps_mode": {"enum": ["CFR", "VFR"]},
        "nominal_fps": {"type": "number", "exclusiveMinimum": 0},
        "frame_count": {"type": "integer", "minimum": 2},
        "frame_pts_sec": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "minimum": 0}
        },
        "source_frame_pts_sec": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "minimum": 0}
        },
        "annotated_start_source_sec": {"type": "number", "minimum": 0},
        "annotated_end_source_sec": {"type": "number", "exclusiveMinimum": 0},
        "review_start_source_sec": {"type": "number", "minimum": 0},
        "review_end_source_sec": {"type": "number", "exclusiveMinimum": 0},
        "annotated_start_local_frame": {"type": "integer", "minimum": 0},
        "annotated_end_local_frame": {"type": "integer", "minimum": 1},
        "target_status": {"const": "PENDING_EXPERT_REVIEW"}
      }
    }
  }
}
